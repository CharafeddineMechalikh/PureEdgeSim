<?xml version="1.0"?>
<edge_datacenters>
	<!-- One data center, and it is only the access point of the fleet: the
		architecture is CLOUD_ONLY, so every request crosses it on its way to the
		cloud and none of them is served here. It is wide enough that the local hop
		never is the bottleneck, which keeps the shared metropolitan uplink as the
		only resource the requests compete for. -->
	<datacenter name="dc1">
		<periphery>true</periphery>
		<idleConsumption>100</idleConsumption>
		<maxConsumption>250</maxConsumption>
		<isOrchestrator>false</isOrchestrator>
		<location>
			<x_pos>100</x_pos>
			<y_pos>100</y_pos>
		</location>
		<cores>50</cores>
		<mips>40000</mips>
		<ram>16000</ram>
		<storage>200000</storage>
	</datacenter>
	<network_links>
		<!-- A single data center, so there is nothing to link. -->
	</network_links>
</edge_datacenters>
