<?xml version="1.0"?>
<cloud_data_centers>
	<!-- Same reason as the edge data center: MIST_ONLY never asks the cloud for
		anything, and the topology needs it to exist to hang the wide area link on.
		It is on mains power too, so the only batteries that empty in this scenario
		are the forty in the fleet. -->
	<datacenter>
		<idleConsumption>0</idleConsumption>
		<maxConsumption>5776</maxConsumption>
		<isOrchestrator>false</isOrchestrator>
		<cores>200</cores>
		<mips>40000</mips>
		<ram>16000</ram>
		<storage>1000000</storage>
	</datacenter>
</cloud_data_centers>
