<?xml version="1.0"?>
<edge_devices>
	<!-- here you can define the types of edge devices, and how many devices 
		of this type there will be in this case , there are 4 types of devices(defined 
		here), 30 percent of all devices will be of the first type, this percentage 
		is defined here <percentage> -->

	<!-- Every numeric value of a device may be a probability distribution
		instead of a fixed number. Each instance of the type then draws its own
		value, which is how a heterogeneous fleet is described:

		<mips distribution="normal" mean="25000" std="3000" min="5000"/>
		<ram distribution="uniform" min="2048" max="8192"/>
		<speed distribution="triangular" min="0.5" mode="1.4" max="3"/>

		Add min and max attributes to bound the generated values whatever the
		distribution. See docs/models.md for the list of distributions.

		The mobility element may also select a mobility model by name and pass it
		options as attributes. Without the model attribute the random waypoint
		model is used, as before:

		<mobility model="gauss-markov" alpha="0.8" std="30">true</mobility>
		<mobility model="waypoint" waypoints="50,50;250,150;150,250">true</mobility>
		<mobility model="manhattan" grid_size="50">true</mobility>

		Known models: random-waypoint (default), random-walk, gauss-markov,
		manhattan, waypoint, circular, levy-walk, brownian and group. Each device
		type may use a different one. See docs/models.md for the options.

		Devices of a type are placed uniformly on the map. To cluster them around
		an area instead, add a location element with distribution coordinates:

		<location>
			<x_pos distribution="normal" mean="150" std="30" min="0" max="300"/>
			<y_pos distribution="normal" mean="150" std="30" min="0" max="300"/>
		</location> -->

	<device arch="x86" os="linux" vmm="xen">
		<!-- this is a smartphone, for example -->
		<connectivity>wifi</connectivity> <!-- the type of network connection -->
		<mobility>true</mobility> <!-- the device is mobile or fixed -->
		<speed>1.8</speed> <!-- the speed of the device in meters per second : 1.4m/s equals 5km/h, 0 = non mobile-->
		<minPauseDuration>100</minPauseDuration> <!-- the minimum delay before moving to a new location-->
		<maxPauseDuration>400</maxPauseDuration> <!-- the maximum delay before moving to a new location-->
		<minMobilityDuration>60</minMobilityDuration> <!-- the minimum delay before stopping-->
		<maxMobilityDuration>100</maxMobilityDuration> <!-- the maximum delay before stopping-->
		<battery>true</battery> <!-- relies on battery? -->
		<percentage>18</percentage> <!-- percentage of this device type -->
		<batteryCapacity>18.75</batteryCapacity> <!-- battery capacity in Watt-Hour -->
		<initialBatteryLevel>100</initialBatteryLevel> <!-- initial battery percentage. e.g. set it to 50 in order to generate devices with 50% remaining energy-->
		<idleConsumption>0.2</idleConsumption> <!-- idle energy consumption/
			second, default=0 .000010975 -->
		<maxConsumption>5</maxConsumption> <!-- max energy consumption/second,
			when device cpu is use at 100% -->
		<isOrchestrator>false</isOrchestrator> <!-- it has a task orchestrator or not -->
		<generateTasks>true</generateTasks> <!-- it generates data/tasks or not -->
		<cores>8</cores>
		<mips>25000</mips>
		<ram>4000</ram>
		<storage>256</storage> <!--256MB of caching memory used in example 6 -->
	</device>
	<device arch="x86" os="linux" vmm="xen">
