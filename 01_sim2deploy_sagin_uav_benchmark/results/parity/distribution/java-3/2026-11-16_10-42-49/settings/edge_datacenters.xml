	<datacenter name="G-MEC-1">
		<periphery>true</periphery>
		<idleConsumption>100</idleConsumption>
		<maxConsumption>300</maxConsumption>
		<isOrchestrator>false</isOrchestrator>
		<location>
			<x_pos>125</x_pos>
			<y_pos>125</y_pos>
		</location>
		<cores>16</cores>
		<mips>80000</mips>
		<ram>32000</ram>
		<storage>500000</storage>
	</datacenter>
	<datacenter name="G-MEC-2">
		<periphery>true</periphery>
